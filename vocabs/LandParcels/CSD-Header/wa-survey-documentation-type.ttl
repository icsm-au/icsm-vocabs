:2-year-certificate
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "A certificate by the licensed surveyor, required where a plan of survey is not lodged within 2 years of ground marking, that the survey has been inspected and all marks are intact (regulation 53A of the Licensed Surveyors (General Surveying Practice) Regulations 1961)." ;
    skos:inScheme cs: ;
    skos:notation "2-year-certificate" ;
    skos:prefLabel "2 year certificate" ;
    skos:topConceptOf cs: ;
.

:2d-plan
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "Plan in PDF format" ;
    skos:inScheme cs: ;
    skos:notation "2d-plan" ;
    skos:prefLabel "Plan (PDF)" ;
    skos:topConceptOf cs: ;
.

:2d-plan-survey-sheet
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "Plan Survey Sheet in PDF format" ;
    skos:inScheme cs: ;
    skos:notation "2d-plan-survey-sheet" ;
    skos:prefLabel "Plan - Survey Sheet (PDF)" ;
    skos:topConceptOf cs: ;
.

:3d-plan
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "Plan in 3DCSDM format" ;
    skos:inScheme cs: ;
    skos:notation "3d-plan" ;
    skos:prefLabel "Plan (3DCSDM)" ;
    skos:topConceptOf cs: ;
.

:3d-plan-survey-sheet
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "Plan Survey Sheet in 3DCSDM format" ;
    skos:inScheme cs: ;
    skos:notation "3d-plan-survey-sheet" ;
    skos:prefLabel "Plan - Survey Sheet (3DCSDM)" ;
    skos:topConceptOf cs: ;
.

:certificate-of-title
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "An official document issued by an appropriate jurisdictional authority identifying the owner(s) of Real property along with any encumbrances over the property." ;
    skos:inScheme cs: ;
    skos:notation "certificate-of-title" ;
    skos:prefLabel "Certificate of Title" ;
    skos:topConceptOf cs: ;
.

:csd
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "A Cadastral Survey Data (CSD) prepared for lodgement with Landgate to meet the requirements of Transfer of Land (Surveys) Regulations 1995; Regulation 3." ;
    skos:inScheme cs: ;
    skos:notation "csd" ;
    skos:prefLabel "Cadastral Survey Dataset" ;
    skos:topConceptOf cs: ;
.

:field-record
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "Field book in PDF or image format" ;
    skos:inScheme cs: ;
    skos:notation "field-record" ;
    skos:prefLabel "Field record" ;
    skos:topConceptOf cs: ;
.

:field-record-certificate
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "The certificate by which the licensed surveyor who carried out an authorised survey accepts full responsibility for the field record and the survey it represents (regulation 17(1) of the Licensed Surveyors (General Surveying Practice) Regulations 1961)." ;
    skos:inScheme cs: ;
    skos:notation "field-record-certificate" ;
    skos:prefLabel "Field record certificate" ;
    skos:topConceptOf cs: ;
.

:final-survey-certificate
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "A certificate by the licensed surveyor that the marks shown on the plan of survey and in the referenced field records were in place on a stated date, lodged before the plan is made in order for dealings (regulation 55E of the Licensed Surveyors (General Surveying Practice) Regulations 1961)." ;
    skos:inScheme cs: ;
    skos:notation "final-survey-certificate" ;
    skos:prefLabel "Final Survey Certificate" ;
    skos:topConceptOf cs: ;
.

:initial-survey-certificate
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "A certificate by the licensed surveyor, lodged with the Inspector of Plans and Surveys where final marking is deferred under a regulation 26A approval, that the survey complies with the conditions of that approval, with an undertaking to complete the marking and lodge survey sheets after construction (Land Surveyors Licensing Board, Survey Practice Guidelines for Subdivisions within Special Survey Areas, guideline 9.3)." ;
    skos:inScheme cs: ;
    skos:notation "initial-survey-certificate" ;
    skos:prefLabel "Initial Survey Certificate" ;
    skos:topConceptOf cs: ;
.

:limited-marking-approval
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "An approval from the Inspector of Plans and Surveys at Landgate, under regulation 26A of the Licensed Surveyors (General Surveying Practice) Regulations 1961, for a survey to be marked or referenced in a limited or deferred way rather than in full, for example a road casement survey." ;
    skos:inScheme cs: ;
    skos:notation "limited-marking-approval" ;
    skos:prefLabel "Limited marking approval" ;
    skos:topConceptOf cs: ;
.

:plan-scheme
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "Scheme Reference that this is parent or child of which this is part" ;
    skos:inScheme cs: ;
    skos:notation "plan-scheme" ;
    skos:prefLabel "Plan Scheme" ;
    skos:topConceptOf cs: ;
.

:road-name-exemption
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "Evidence, lodged with a plan that creates a road or road extension, that an approved road name is not required for that road." ;
    skos:inScheme cs: ;
    skos:notation "road-name-exemption" ;
    skos:prefLabel "Road Name Exemption" ;
    skos:topConceptOf cs: ;
.

:scheme-form
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "Multiple forms for additional scheme information" ;
    skos:inScheme cs: ;
    skos:notation "scheme-form" ;
    skos:prefLabel "Scheme Form" ;
    skos:topConceptOf cs: ;
.

:scheme-record-form
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "Record of Scheme Schedule (formerly Form 8)" ;
    skos:inScheme cs: ;
    skos:notation "scheme-record-form" ;
    skos:prefLabel "Scheme Record Form" ;
    skos:topConceptOf cs: ;
.

:scheme-ue
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "Scheme Schedule of Unit Entitlement (version required)" ;
    skos:inScheme cs: ;
    skos:notation "scheme-ue" ;
    skos:prefLabel "Scheme (UE)" ;
    skos:topConceptOf cs: ;
.

:sketch-plan
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "Supporting document" ;
    skos:inScheme cs: ;
    skos:notation "sketch-plan" ;
    skos:prefLabel "Sketch plan" ;
    skos:topConceptOf cs: ;
.

:survey-report
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "Survey Report and/or additional notes" ;
    skos:inScheme cs: ;
    skos:notation "survey-report" ;
    skos:prefLabel "Survey Report" ;
    skos:topConceptOf cs: ;
.

:wapc-exemption
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "Evidence, lodged with a plan, that the plan does not need Western Australian Planning Commission approval because it is for a public work under section 6 of the Planning and Development Act 2005." ;
    skos:inScheme cs: ;
    skos:notation "wapc-exemption" ;
    skos:prefLabel "WAPC exemption" ;
    skos:topConceptOf cs: ;
.

